{
  "compilerOptions": {
    "target": "ES2020", // era ES2016
    "module": "CommonJS",
    "outDir": "./dist", // saída dos arquivos compilados
    "rootDir": "./src", // origem do código TS
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
